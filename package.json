{
  "name": "good-choice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run db:check && npm run build",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "tsx scripts/check-migrations.ts",
    "db:migrate:local": "wrangler d1 migrations apply good-choice-db --local",
    "db:migrate:remote": "tsx scripts/check-deploy.ts && wrangler d1 migrations apply good-choice-db --remote",
    "db:seed:local": "tsx scripts/seed.ts --local",
    "db:seed:remote": "tsx scripts/check-deploy.ts && tsx scripts/seed.ts --remote",
    "db:setup": "npm run db:migrate:local && npm run db:seed:local",
    "deploy": "tsx scripts/check-deploy.ts && npm run build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.44.7",
    "hono": "^4.10.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.7",
    "@cloudflare/workers-types": "^4.20250917.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "0.31.4",
    "shadcn": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0"
  }
}
