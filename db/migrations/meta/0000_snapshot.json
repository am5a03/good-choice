          "value": "(\"nutrition\".\"fat\" IS NULL OR \"nutrition\".\"fat\" BETWEEN 0 AND 100) AND (\"nutrition\".\"saturated\" IS NULL OR \"nutrition\".\"saturated\" BETWEEN 0 AND 100) AND (\"nutrition\".\"carbs\" IS NULL OR \"nutrition\".\"carbs\" BETWEEN 0 AND 100) AND (\"nutrition\".\"sugars\" IS NULL OR \"nutrition\".\"sugars\" BETWEEN 0 AND 100) AND (\"nutrition\".\"added_sugars\" IS NULL OR \"nutrition\".\"added_sugars\" BETWEEN 0 AND 100) AND (\"nutrition\".\"fibre\" IS NULL OR \"nutrition\".\"fibre\" BETWEEN 0 AND 100) AND (\"nutrition\".\"protein\" IS NULL OR \"nutrition\".\"protein\" BETWEEN 0 AND 100)"
        },
