          "name": "nutrition_sugar_subset",
          "value": "\"nutrition\".\"sugars\" IS NULL OR \"nutrition\".\"carbs\" IS NULL OR \"nutrition\".\"sugars\" <= \"nutrition\".\"carbs\""
